# Copy this file to .env and fill in every value before `docker compose up`.
# The stack intentionally refuses to start with a missing secret.

# Postgres password. Use a URL-safe value (letters, numbers, - and _).
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
# Must be at least 32 characters. There is no built-in default.
JWT_SECRET=

# First admin account, used only by `python seed.py`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=

# Frontend host port.
FRONTEND_PORT=8080

# Optional tuning.
JWT_EXPIRE_MINUTES=60
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
JUDGE_IMAGE=cf-clone-v2-judge:latest
# auto uses the runsc runtime when the Docker daemon advertises it.
JUDGE_RUNTIME=auto
JUDGE_MAX_OUTPUT_BYTES=102400
